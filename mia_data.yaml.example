deployment: mia-data
github:
  data_repo: JaneliaSciComp/mia-workflow-data
  trusted_bots: []       # app logins whose data:go counts without write access, quoted: ["mia-autodev[bot]"] (the buffer worker)
  snippets_repo: JaneliaSciComp/mia-snippets
  catalog_repo: AI-HHMI/mia-agentic-search
  auth: token            # token | app (app needs app_id, installation_id, private_key_path)
  token_env: GITHUB_TOKEN
temporal:
  address: localhost:7233
  namespace: mia-data
  via_https_proxy: false
  poll_minutes: 2
paths:
  state_dir: ~/.local/state/mia-data
  # a root is a path, or {path, url} with the Fileglancer (or other browser) URL of that folder:
  # issue comments then link the round's workspace and the dataset's crops folder
  work_root:
    path: /shared/TBD/mia-data-work
    url: https://fileglancer.example.org/browse/TBD/mia-data-work
  storage_root:
    path: /shared/TBD/mia-crops
    url: https://fileglancer.example.org/browse/TBD/mia-crops
gallery:
  branch: galleries
crops:
  size: 256
  per_round: 16
  test_per_round: 4
  per_plane: 4
  per_file: 8
  licences: [CC0-1.0, CC-BY-4.0, CC-BY-3.0, MIT]
limits:
  job_bytes: 5e9
  job_walltime_min: 120
  agent_max_budget_usd: 5
  max_stage_attempts: 1
  max_pr_revisions: 5
agent:                   # match job; its walltime is limits.job_walltime_min. autodev's agent.allow_hosts,
  model: sonnet          # extra_mounts and api_key_env are not used by mia-data (config rejects them)
  cpus: 1
  mem_mb: 4000
  path_prepend: []
harness:
  dir: /path/to/mia-snippets-checkout   # pinned per round by commit + pixi.lock digest
network:
  package_hosts: [pypi.org, files.pythonhosted.org, conda.anaconda.org, repo.prefix.dev]
  redirect_hosts: {}     # filled from the redirect probe; exact hosts, no patterns
